<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Hospital.Client.PatientShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Hospital.Client"
    xmlns:views="clr-namespace:Hospital.Client.Views"
    Title="Hasta portalı"
    FlyoutBehavior="Flyout"
    FlyoutWidth="300">

    <Shell.ItemTemplate>
        <DataTemplate>
            <Grid Padding="14,10"
                  ColumnDefinitions="Auto,*"
                  ColumnSpacing="12"
                  BackgroundColor="Transparent">
                <Border WidthRequest="10"
                        HeightRequest="10"
                        VerticalOptions="Center"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource Primary}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="5" />
                    </Border.StrokeShape>
                </Border>
                <Label Grid.Column="1"
                       Text="{Binding Title}"
                       VerticalOptions="Center"
                       FontFamily="OpenSansSemibold"
                       FontSize="15"
                       TextColor="{StaticResource TextPrimary}" />
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

    <Shell.FlyoutHeader>
        <views:PortalFlyoutHeader BadgeText="H"
                                  Headline="Hasta portalı"
                                  Tagline="Bilgileriniz ve randevularınız" />
    </Shell.FlyoutHeader>

    <FlyoutItem Title="Ana sayfa">
        <ShellContent ContentTemplate="{DataTemplate local:PatientHomePage}" Route="PatientHomePage" />
    </FlyoutItem>

    <FlyoutItem Title="Randevularım">
        <ShellContent ContentTemplate="{DataTemplate local:PatientAppointmentsPage}" Route="PatientAppointmentsPage" />
    </FlyoutItem>

    <FlyoutItem Title="Randevu al">
        <ShellContent ContentTemplate="{DataTemplate local:PatientBookAppointmentPage}" Route="PatientBookAppointmentPage" />
    </FlyoutItem>

    <FlyoutItem Title="Sağlık özeti">
        <ShellContent ContentTemplate="{DataTemplate local:PatientTimelinePage}" Route="PatientTimelinePage" />
    </FlyoutItem>

    <FlyoutItem Title="Tetkiklerim">
        <ShellContent ContentTemplate="{DataTemplate local:PatientLabReportsPage}" Route="PatientLabReportsPage" />
    </FlyoutItem>

    <FlyoutItem Title="Bilgilerim">
        <ShellContent ContentTemplate="{DataTemplate local:PatientProfilePage}" Route="PatientProfilePage" />
    </FlyoutItem>

    <FlyoutItem Title="Şifre Değiştir">
        <ShellContent ContentTemplate="{DataTemplate local:ChangePasswordPage}" Route="PatientChangePasswordPage" />
    </FlyoutItem>

    <Shell.FlyoutFooter>
        <VerticalStackLayout Padding="16,12,16,14"
                             Spacing="10"
                             BackgroundColor="#E8F4FC">
            <views:HospitalFooterBar Margin="0,0,0,4" />
            <Label x:Name="FlyoutFooterVersion"
                   FontSize="11"
                   TextColor="{StaticResource TextSecondary}"
                   HorizontalTextAlignment="Center" />
            <Button Text="Çıkış Yap"
                    Style="{StaticResource OutlineButton}"
                    Clicked="OnLogoutClicked" />
        </VerticalStackLayout>
    </Shell.FlyoutFooter>
</Shell>
