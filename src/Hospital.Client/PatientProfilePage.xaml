<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Hospital.Client.PatientProfilePage"
             Title="Bilgilerim">
    <Shell.BackButtonBehavior>
        <BackButtonBehavior TextOverride="Geri" />
    </Shell.BackButtonBehavior>
    <Grid RowDefinitions="Auto,*"
          MaximumWidthRequest="720" HorizontalOptions="Center">
        <VerticalStackLayout Style="{StaticResource PageHeroPanel}">
            <Label Text="Bilgilerim"
                   Style="{StaticResource PageHeroTitle}"
                   FontSize="20" />
            <Label Text="Kimlik bilgileriniz değiştirilemez; iletişim ve acil durum kişisini güncelleyebilirsiniz."
                   Style="{StaticResource PageHeroSubtitle}" />
        </VerticalStackLayout>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="{StaticResource PageScrollContentPadding}" Spacing="14">
                <Border Style="{StaticResource ElevatedCard}" Padding="22,20">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="Kimlik"
                               FontFamily="OpenSansSemibold"
                               FontSize="14" />
                        <Label x:Name="FullNameLabel" FontSize="18" FontFamily="OpenSansSemibold" />
                        <Label x:Name="NationalIdLabel" FontSize="14" TextColor="{StaticResource TextSecondary}" />
                        <Label x:Name="BirthLabel" FontSize="14" TextColor="{StaticResource TextSecondary}" />

                        <BoxView HeightRequest="1" Color="{StaticResource BorderSubtle}" />

                        <Label Text="İletişim"
                               FontFamily="OpenSansSemibold"
                               FontSize="14" />
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Telefon" Style="{StaticResource SectionLabel}" Margin="0" />
                            <Border Style="{StaticResource FormFieldBorder}" Padding="10,6">
                                <Entry x:Name="PhoneEntry" Keyboard="Telephone" TextColor="{StaticResource TextPrimary}" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="E-posta" Style="{StaticResource SectionLabel}" Margin="0" />
                            <Border Style="{StaticResource FormFieldBorder}" Padding="10,6">
                                <Entry x:Name="EmailEntry" Keyboard="Email" TextColor="{StaticResource TextPrimary}" />
                            </Border>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="{StaticResource BorderSubtle}" />

                        <Label Text="Acil durumda ulaşılacak kişi"
                               FontFamily="OpenSansSemibold"
                               FontSize="14" />
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Ad soyad" Style="{StaticResource SectionLabel}" Margin="0" />
                            <Border Style="{StaticResource FormFieldBorder}" Padding="10,6">
                                <Entry x:Name="EmergencyNameEntry" TextColor="{StaticResource TextPrimary}" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Yakınlık" Style="{StaticResource SectionLabel}" Margin="0" />
                            <Border Style="{StaticResource FormFieldBorder}" Padding="10,6">
                                <Entry x:Name="EmergencyRelationEntry"
                                       Placeholder="Eş, anne, kardeş..."
                                       TextColor="{StaticResource TextPrimary}" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Telefon" Style="{StaticResource SectionLabel}" Margin="0" />
                            <Border Style="{StaticResource FormFieldBorder}" Padding="10,6">
                                <Entry x:Name="EmergencyPhoneEntry" Keyboard="Telephone" TextColor="{StaticResource TextPrimary}" />
                            </Border>
                        </VerticalStackLayout>

                        <Button Text="Kaydet" Clicked="OnSaveClicked" />
                    </VerticalStackLayout>
                </Border>
                <Label x:Name="ErrorLabel"
                       IsVisible="False"
                       TextColor="#B71C1C"
                       FontSize="13"
                       LineBreakMode="WordWrap" />
                <Grid x:Name="BusyOverlay"
                      IsVisible="False"
                      HeightRequest="120">
                    <ActivityIndicator x:Name="BusySpinner" IsRunning="False" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
