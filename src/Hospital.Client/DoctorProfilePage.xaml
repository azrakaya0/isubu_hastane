<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Hospital.Client.DoctorProfilePage"
             Title="Profilim">
    <Shell.BackButtonBehavior>
        <BackButtonBehavior TextOverride="Geri" />
    </Shell.BackButtonBehavior>
    <Grid RowDefinitions="Auto,*"
          MaximumWidthRequest="720" HorizontalOptions="Center">
        <VerticalStackLayout Style="{StaticResource PageHeroPanel}">
            <Label Text="Profilim"
                   Style="{StaticResource PageHeroTitle}"
                   FontSize="20" />
            <Label Text="Hastane içi iletişim ve çalışma alanı bilgileriniz."
                   Style="{StaticResource PageHeroSubtitle}" />
        </VerticalStackLayout>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="{StaticResource PageScrollContentPadding}" Spacing="14">
                <Border Style="{StaticResource ElevatedCard}" Padding="22,20">
                    <VerticalStackLayout Spacing="12">
                        <Label x:Name="FullNameLabel" FontSize="18" FontFamily="OpenSansSemibold" />
                        <Label x:Name="SpecialtyLabel" FontSize="14" TextColor="{StaticResource TextSecondary}" />
                        <Label x:Name="ClinicLabel" FontSize="14" TextColor="{StaticResource TextSecondary}" />
                        <BoxView HeightRequest="1" Color="{StaticResource BorderSubtle}" />
                        <Label Text="İletişim ve konum"
                               FontFamily="OpenSansSemibold"
                               FontSize="14" />
                        <Label x:Name="OfficeLabel" FontSize="14" LineBreakMode="WordWrap" />
                        <Label x:Name="PhoneLabel" FontSize="14" TextColor="{StaticResource TextSecondary}" />
                        <Label x:Name="EmailLabel" FontSize="14" TextColor="{StaticResource TextSecondary}" />
                        <Label Text="Oda ve iletişim bilgileri hastane yönetimi tarafından güncellenir."
                               FontSize="12"
                               TextColor="{StaticResource TextSecondary}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>
                <Label x:Name="ErrorLabel"
                       IsVisible="False"
                       TextColor="#B71C1C"
                       FontSize="13"
                       LineBreakMode="WordWrap" />
                <Grid x:Name="BusyOverlay"
                      IsVisible="False"
                      HeightRequest="120">
                    <ActivityIndicator x:Name="BusySpinner" IsRunning="False" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
