<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Hospital.Client.ChangePasswordPage"
             Title="Şifre Değiştir">
    <Shell.BackButtonBehavior>
        <BackButtonBehavior TextOverride="Geri" />
    </Shell.BackButtonBehavior>
    <Grid RowDefinitions="Auto,*"
          MaximumWidthRequest="680" HorizontalOptions="Center">
        <VerticalStackLayout Grid.Row="0"
                             Style="{StaticResource PageHeroPanel}">
            <Label Text="Hesap güvenliği"
                   Style="{StaticResource PageHeroTitle}" />
            <Label Text="Mevcut şifrenizi doğrulayın; yeni şifre en az 6 karakter olmalıdır."
                   Style="{StaticResource PageHeroSubtitle}" />
        </VerticalStackLayout>

        <Grid Grid.Row="1">
            <ScrollView BackgroundColor="Transparent">
            <Grid Padding="{StaticResource PageScrollContentPadding}" ColumnDefinitions="*">
                <Border Grid.Column="0"
                        Style="{StaticResource FormSheetCard}"
                        Margin="0,0,0,8">
                    <VerticalStackLayout Padding="28,26" Spacing="18">
                        <Label Text="Yeni şifre"
                               Style="{StaticResource FormSubSectionTitle}"
                               Margin="0,0,0,0" />

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Mevcut şifre" Style="{StaticResource SectionLabel}" Margin="0" />
                            <Border Style="{StaticResource FormFieldBorder}">
                                <Entry x:Name="CurrentPasswordEntry"
                                       Placeholder="Şu an kullandığınız şifre"
                                       IsPassword="True"
                                       MaxLength="128"
                                       BackgroundColor="Transparent"
                                       TextColor="{StaticResource TextPrimary}" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Yeni şifre" Style="{StaticResource SectionLabel}" Margin="0" />
                            <Border Style="{StaticResource FormFieldBorder}">
                                <Entry x:Name="NewPasswordEntry"
                                       Placeholder="En az 6 karakter"
                                       IsPassword="True"
                                       MaxLength="128"
                                       BackgroundColor="Transparent"
                                       TextColor="{StaticResource TextPrimary}" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Yeni şifre (tekrar)" Style="{StaticResource SectionLabel}" Margin="0" />
                            <Border Style="{StaticResource FormFieldBorder}">
                                <Entry x:Name="ConfirmPasswordEntry"
                                       Placeholder="Tekrar yazın"
                                       IsPassword="True"
                                       MaxLength="128"
                                       BackgroundColor="Transparent"
                                       TextColor="{StaticResource TextPrimary}" />
                            </Border>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="{StaticResource BorderSubtle}" Margin="0,8,0,4" />

                        <Button Text="Şifreyi güncelle"
                                Margin="0,4,0,0"
                                Clicked="OnSaveClicked" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
            </ScrollView>
            <Grid x:Name="BusyOverlay"
                  IsVisible="False"
                  BackgroundColor="#DDF5FAFF"
                  ZIndex="100">
                <ActivityIndicator x:Name="BusySpinner"
                                   IsRunning="False"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center"
                                   Scale="1.1" />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
