<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Hospital.Client.Views.PortalFlyoutHeader">
    <Border Padding="0"
            StrokeThickness="0"
            InputTransparent="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0D47A1" Offset="0" />
                <GradientStop Color="#1976D2" Offset="0.55" />
                <GradientStop Color="#42A5F5" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Grid Padding="20,22,20,18"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="16">
            <Border WidthRequest="54"
                    HeightRequest="54"
                    Padding="0"
                    StrokeThickness="0"
                    BackgroundColor="#26FFFFFF"
                    VerticalOptions="Start">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <Label x:Name="BadgeLabel"
                       FontFamily="OpenSansSemibold"
                       FontSize="20"
                       TextColor="White"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                <Label x:Name="HeadlineLabel"
                       FontFamily="OpenSansSemibold"
                       FontSize="18"
                       TextColor="White"
                       LineBreakMode="TailTruncation" />
                <Label x:Name="TaglineLabel"
                       FontSize="12"
                       TextColor="#E3F2FD"
                       LineBreakMode="WordWrap"
                       MaxLines="2" />
                <BoxView HeightRequest="1"
                         Color="#40FFFFFF"
                         Margin="0,4,0,0" />
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>
