<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Hospital.Client.LabReportDetailPage"
             Title="Tetkik detayı">
    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Style="{StaticResource PageHeroPanel}">
            <Label x:Name="HeroTitle"
                   Text="Tetkik detayı"
                   Style="{StaticResource PageHeroTitle}"
                   FontSize="20" />
            <Label x:Name="HeroSubtitle"
                   Style="{StaticResource PageHeroSubtitle}" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1" BackgroundColor="Transparent">
            <VerticalStackLayout Padding="{StaticResource PageScrollContentPadding}"
                                 Spacing="14">
                <Border Style="{StaticResource ElevatedCard}" Padding="18,16" Margin="{StaticResource PageListMargin}">
                    <VerticalStackLayout Spacing="14">
                        <HorizontalStackLayout Spacing="12" HorizontalOptions="Fill">
                            <Border x:Name="CategoryRibbon"
                                    Padding="10,6"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Label x:Name="CategoryLabel"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="12"
                                       VerticalOptions="Center" />
                            </Border>
                            <Label x:Name="DateLabel"
                                   VerticalOptions="Center"
                                   FontSize="13"
                                   TextColor="{StaticResource TextSecondary}" />
                        </HorizontalStackLayout>

                        <Border x:Name="CriticalPanel"
                                Padding="14,12"
                                IsVisible="False"
                                BackgroundColor="#FFEBEE"
                                Stroke="#E57373"
                                StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Klinik uyarı bandı"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="14"
                                       TextColor="#B71C1C" />
                                <Label Text="Özet metinde öne çıkan uyarı anahtar kelimeleri tespit edildi. Tetkik yorumunun nihai değerlendirmesi hastayı bilgilendiren hekime aittir."
                                       FontSize="13"
                                       TextColor="#B71C1C"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>

                        <Label x:Name="TitleLabel"
                               FontFamily="OpenSansSemibold"
                               FontSize="18"
                               TextColor="{StaticResource TextPrimary}"
                               LineBreakMode="WordWrap" />

                        <BoxView HeightRequest="1" Color="{StaticResource BorderSubtle}" />

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Özet / sonuç"
                                   Style="{StaticResource SectionLabel}"
                                   Margin="0" />
                            <Label x:Name="SummaryLabel"
                                   FontSize="14"
                                   TextColor="{StaticResource TextSecondary}"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>

                        <VerticalStackLayout x:Name="DoctorPanel"
                                             Spacing="4"
                                             IsVisible="False">
                            <Label Text="İsteyen hekim"
                                   Style="{StaticResource SectionLabel}"
                                   Margin="0" />
                            <Label x:Name="DoctorLabel"
                                   FontSize="14"
                                   TextColor="{StaticResource TextPrimary}" />
                        </VerticalStackLayout>

                        <Label x:Name="MetaLabel"
                               FontSize="11"
                               TextColor="{StaticResource TextSecondary}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <Button Margin="20,0,20,20"
                        Text="Kapat"
                        Clicked="OnCloseClicked"
                        HorizontalOptions="Fill" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
