<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Hospital.Client.ClinicEditPage"
             Title="Poliklinik">
    <Shell.BackButtonBehavior>
        <BackButtonBehavior TextOverride="Geri" />
    </Shell.BackButtonBehavior>
    <Grid RowDefinitions="Auto,*"
          MaximumWidthRequest="800" HorizontalOptions="Center">
        <VerticalStackLayout Grid.Row="0"
                             Style="{StaticResource PageHeroPanel}">
            <Label Text="Poliklinik tanımı"
                   Style="{StaticResource PageHeroTitle}" />
            <Label Text="Birim adı ve kapsamlı açıklama (hizmet kapsamı, kat, yönlendirme); hasta portalında poliklinik seçiminde görünür."
                   Style="{StaticResource PageHeroSubtitle}" />
        </VerticalStackLayout>

        <Grid Grid.Row="1">
            <ScrollView BackgroundColor="Transparent">
            <Grid Padding="{StaticResource PageScrollContentPadding}" ColumnDefinitions="*">
                <Border Grid.Column="0"
                        Style="{StaticResource FormSheetCard}"
                        Margin="0,0,0,8">
                    <VerticalStackLayout Padding="28,26" Spacing="20">
                        <Label Text="İçerik"
                               Style="{StaticResource FormSubSectionTitle}"
                               Margin="0,0,0,0" />

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Poliklinik numarası" Style="{StaticResource SectionLabel}" Margin="0" />
                            <Border Style="{StaticResource FormFieldBorder}">
                                <Entry x:Name="ClinicNumberEntry"
                                       Placeholder="Örn. 105"
                                       MaxLength="20"
                                       Keyboard="Numeric"
                                       BackgroundColor="Transparent"
                                       TextColor="{StaticResource TextPrimary}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Poliklinik adı" Style="{StaticResource SectionLabel}" Margin="0" />
                            <Border Style="{StaticResource FormFieldBorder}">
                                <Entry x:Name="NameEntry"
                                       Placeholder="Resmi veya kısa ad"
                                       MaxLength="200"
                                       BackgroundColor="Transparent"
                                       TextColor="{StaticResource TextPrimary}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Açıklama" Style="{StaticResource SectionLabel}" Margin="0" />
                            <Border Style="{StaticResource FormFieldBorder}" Padding="12,10">
                                <Editor x:Name="DescriptionEditor"
                                        Placeholder="Hizmet alanı, çalışma saatleri, hazırlık, kat ve yönlendirme (en fazla 2000 karakter)"
                                        AutoSize="TextChanges"
                                        MaxLength="2000"
                                        MinimumHeightRequest="120"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource TextPrimary}" />
                            </Border>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="{StaticResource BorderSubtle}" Margin="0,8,0,4" />

                        <Button Text="Kaydet"
                                Margin="0,4,0,0"
                                Clicked="OnSaveClicked" />
                        <Button x:Name="DeleteButton"
                                Text="Kaydı sil"
                                Style="{StaticResource DangerButton}"
                                Clicked="OnDeleteClicked"
                                IsVisible="False" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
            </ScrollView>
            <Grid x:Name="BusyOverlay"
                  IsVisible="False"
                  BackgroundColor="#DDF5FAFF"
                  ZIndex="100">
                <ActivityIndicator x:Name="BusySpinner"
                                   IsRunning="False"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center"
                                   Scale="1.1" />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
