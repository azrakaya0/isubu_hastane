<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Hospital.Client.Views"
             x:Class="Hospital.Client.LoginPage"
             Title="Giriş"
             Background="{StaticResource LoginBackgroundLight}">
    <Grid>
        <Grid RowDefinitions="*,Auto">
            <ScrollView Grid.Row="0" BackgroundColor="Transparent">
                <VerticalStackLayout Padding="32,40,32,20"
                                     Spacing="0"
                                     MaximumWidthRequest="480"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                    <VerticalStackLayout Spacing="20" Margin="0,0,0,8">
                        <HorizontalStackLayout Spacing="18"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center">
                            <Grid WidthRequest="76"
                                  HeightRequest="76"
                                  VerticalOptions="Center">
                                <Border x:Name="LoginLogoFallback"
                                        WidthRequest="72"
                                        HeightRequest="72"
                                        Padding="0"
                                        StrokeThickness="0"
                                        BackgroundColor="{StaticResource Primary}"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="18" />
                                    </Border.StrokeShape>
                                    <Label Text="+"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="44"
                                           TextColor="White"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"
                                           SemanticProperties.Description="Kurumsal sağlık sistemi logosu" />
                                </Border>
                                <Image x:Name="LoginLogoImage"
                                       Aspect="AspectFit"
                                       IsVisible="False"
                                       Margin="6"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       SemanticProperties.Description="Kurum logosu" />
                            </Grid>
                            <VerticalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label Text="HASTANE BİLGİ SİSTEMİ"
                                       FontSize="11"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="{StaticResource TextSecondary}"
                                       CharacterSpacing="1.2"
                                       VerticalOptions="End" />
                                <Label x:Name="PortalTitleLabel"
                                       Text="Kurumsal giriş"
                                       FontSize="24"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="{StaticResource TextPrimary}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                        <Label x:Name="PortalSubtitleLabel"
                               Text="Hasta kayıtları, poliklinikler, doktorlar ve randevu yönetimi için güvenli oturum açın."
                               FontSize="14"
                               TextColor="{StaticResource TextSecondary}"
                               LineBreakMode="WordWrap"
                               HorizontalTextAlignment="Center"
                               Margin="8,0,8,0" />
                    </VerticalStackLayout>

                    <Border x:Name="ErrorBanner"
                            IsVisible="False"
                            Margin="0,0,0,12"
                            Padding="14,12"
                            BackgroundColor="#FFEBEE"
                            Stroke="#E57373"
                            StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                            <Label x:Name="ErrorBannerMessage"
                                   Grid.Row="0"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   FontSize="13"
                                   TextColor="#B71C1C"
                                   LineBreakMode="WordWrap" />
                            <Button Grid.Row="1"
                                    Grid.Column="1"
                                    Text="Tekrar dene"
                                    Clicked="OnLoginRetryClicked"
                                    Padding="12,8"
                                    FontSize="13"
                                    CornerRadius="8"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource Primary}"
                                    BorderColor="{StaticResource Primary}"
                                    BorderWidth="1.5" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource ElevatedCard}"
                            Padding="28,28"
                            Margin="0,0,0,0">
                        <Border.Shadow>
                            <Shadow Brush="#281565C0" Offset="0,8" Radius="24" Opacity="0.12" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="18">
                            <BoxView HeightRequest="1"
                                     Color="{StaticResource BorderSubtle}"
                                     Margin="0,0,0,4" />

                            <VerticalStackLayout Spacing="10">
                                <Label x:Name="IdentifierLabel"
                                       Text="Kullanıcı adı"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="13"
                                       TextColor="{StaticResource TextSecondary}"
                                       Margin="2,0,0,0" />
                                <Border Padding="14,10"
                                        BackgroundColor="White"
                                        Stroke="{StaticResource BorderSubtle}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Entry x:Name="UserNameEntry"
                                           Placeholder="Kurumsal kullanıcı adınız"
                                           Keyboard="Text"
                                           MaxLength="64"
                                           BackgroundColor="Transparent"
                                           TextColor="{StaticResource TextPrimary}" />
                                </Border>
                                <Label Text="Şifre"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="13"
                                       TextColor="{StaticResource TextSecondary}"
                                       Margin="2,4,0,0" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <Border Padding="14,10"
                                            BackgroundColor="White"
                                            Stroke="{StaticResource BorderSubtle}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Entry x:Name="PasswordEntry"
                                               Placeholder="Şifreniz"
                                               IsPassword="True"
                                               MaxLength="128"
                                               BackgroundColor="Transparent"
                                               TextColor="{StaticResource TextPrimary}" />
                                    </Border>
                                    <Button x:Name="PasswordVisibilityButton"
                                            Grid.Column="1"
                                            Text="Göster"
                                            Style="{StaticResource LinkTextButton}"
                                            VerticalOptions="Center"
                                            SemanticProperties.Hint="Şifreyi göster veya gizle"
                                            Clicked="OnTogglePasswordVisibility" />
                                </Grid>
                            </VerticalStackLayout>

                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="10"
                                  RowSpacing="0">
                                <CheckBox x:Name="AcceptTermsCheckBox"
                                          Grid.Column="0"
                                          VerticalOptions="Start"
                                          Margin="0,2,0,0" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Kullanım koşullarını ve kişisel verilerin korunmasına ilişkin aydınlatmayı okudum, kabul ediyorum."
                                           FontSize="13"
                                           TextColor="{StaticResource TextPrimary}"
                                           LineBreakMode="WordWrap" />
                                    <Label Text="Kullanıcı sözleşmesini oku"
                                           FontSize="12"
                                           FontFamily="OpenSansSemibold"
                                           TextColor="{StaticResource Primary}"
                                           TextDecorations="Underline"
                                           Margin="0,4,0,0">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnTermsTapped" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </VerticalStackLayout>
                            </Grid>

                            <Button Text="Güvenli giriş"
                                    BackgroundColor="{StaticResource Primary}"
                                    TextColor="White"
                                    FontFamily="OpenSansSemibold"
                                    CornerRadius="10"
                                    Padding="18,14"
                                    SemanticProperties.Hint="Sunucuya bağlanarak oturum açar"
                                    Clicked="OnLoginClicked" />

                            <Label x:Name="PortalHintLabel"
                                   Text="Test hesabı: admin / Admin123!"
                                   FontSize="12"
                                   TextColor="{StaticResource TextSecondary}"
                                   HorizontalTextAlignment="Center"
                                   Margin="0,4,0,0" />
                            <Label Text="Şifre sıfırlama ve erişim sorunları için bilgi işlem biriminize başvurun."
                                   FontSize="11"
                                   TextColor="{StaticResource TextSecondary}"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="WordWrap"
                                   Opacity="0.9" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>

            <views:HospitalFooterBar Grid.Row="1" Margin="20,0,20,16" />
        </Grid>

        <Grid x:Name="BusyOverlay"
              IsVisible="False"
              BackgroundColor="#DDF5FAFF"
              ZIndex="200">
            <ActivityIndicator x:Name="BusySpinner"
                               IsRunning="False"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               Scale="1.2" />
        </Grid>
    </Grid>
</ContentPage>
