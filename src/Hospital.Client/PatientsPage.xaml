<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Hospital.Client.Views"
             x:Class="Hospital.Client.PatientsPage"
             Title="Hastalar">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="0"
          MaximumWidthRequest="720" HorizontalOptions="Center"
          VerticalOptions="FillAndExpand">
        <VerticalStackLayout Grid.Row="0"
                             Style="{StaticResource PageHeroPanel}">
            <Label Text="Hasta listesi"
                   Style="{StaticResource PageHeroTitle}"
                   FontSize="20" />
            <Label Text="Ad, telefon veya T.C. ile arayın; satıra dokunarak kaydı açın. Listeyi yenilemek için aşağı çekin."
                   Style="{StaticResource PageHeroSubtitle}" />
        </VerticalStackLayout>

        <Button Grid.Row="1"
                Text="+ Yeni hasta kaydı oluştur"
                Style="{StaticResource AddNewButton}"
                Margin="12,10,12,0"
                Padding="16,14"
                FontSize="16"
                Clicked="OnAddClicked" />

        <Border Grid.Row="2"
                Style="{StaticResource ElevatedCard}"
                Padding="18,16"
                Margin="12,8,12,0">
            <VerticalStackLayout Spacing="14">
                <Label Text="Arama"
                       Style="{StaticResource FormSubSectionTitle}"
                       Margin="0,-4,0,-4" />
                <Border Style="{StaticResource FormFieldBorder}">
                    <Entry x:Name="SearchEntry"
                           Placeholder="Ad, soyad, telefon veya e-posta"
                           MaxLength="120"
                           BackgroundColor="Transparent"
                           TextColor="{StaticResource TextPrimary}" />
                </Border>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Border Grid.Column="0" Style="{StaticResource FormFieldBorder}">
                        <Entry x:Name="NationalIdEntry"
                               Placeholder="T.C. kimlik (tam eşleşme)"
                               Keyboard="Numeric"
                               MaxLength="11"
                               BackgroundColor="Transparent"
                               TextColor="{StaticResource TextPrimary}" />
                    </Border>
                    <Button Grid.Column="1"
                            Text="Ara"
                            VerticalOptions="Center"
                            Clicked="OnSearchClicked" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <Grid Grid.Row="3"
              Margin="{StaticResource PageListMargin}"
              RowDefinitions="Auto,*">
            <Border x:Name="PageErrorBanner"
                    Grid.Row="0"
                    IsVisible="False"
                    Margin="0,0,0,10"
                    Padding="14,12"
                    BackgroundColor="#FFEBEE"
                    Stroke="#E57373"
                    StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Label x:Name="PageErrorMessage"
                           Grid.Column="0"
                           FontSize="13"
                           TextColor="#B71C1C"
                           VerticalTextAlignment="Center"
                           LineBreakMode="WordWrap" />
                    <Button Grid.Column="1"
                            Text="Tekrar dene"
                            Clicked="OnPageErrorRetryClicked"
                            Padding="12,8"
                            FontSize="13"
                            CornerRadius="8"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Primary}"
                            BorderColor="{StaticResource Primary}"
                            BorderWidth="1.5"
                            VerticalOptions="Center" />
                </Grid>
            </Border>
            <Grid Grid.Row="1">
            <RefreshView x:Name="RefreshHost" Refreshing="OnRefreshing">
                <CollectionView x:Name="PatientsCollection"
                                Style="{StaticResource AppListCollectionView}"
                                SelectionMode="Single"
                                SelectionChanged="OnSelectionChanged"
                                SemanticProperties.Description="Hasta listesi; bir satıra dokunarak detayı açın.">
                    <CollectionView.EmptyView>
                        <views:EmptyStateView Title="Henüz hasta kaydı yok"
                                              Message="Arama kriterlerinizi değiştirin veya yeni hasta oluşturmak için araç çubuğundaki Yeni’yi kullanın."
                                              Hint="Sunucu bağlantısı yoksa API adresini kontrol edin." />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ListRowCard}">
                                <Grid ColumnDefinitions="*,Auto" RowSpacing="4">
                                    <VerticalStackLayout Spacing="6" HorizontalOptions="Fill">
                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="{Binding FirstName}" FontFamily="OpenSansSemibold" FontSize="17" />
                                            <Label Text="{Binding LastName}" FontFamily="OpenSansSemibold" FontSize="17" />
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding NationalId}" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                                        <Label Text="{Binding Phone}" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1"
                                           Text="{Binding BirthDate, StringFormat='{0:d}'}"
                                           FontSize="13"
                                           FontFamily="OpenSansSemibold"
                                           TextColor="{StaticResource Primary}"
                                           VerticalTextAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.Footer>
                        <Label Padding="0,12,0,4"
                               FontSize="11"
                               TextColor="{StaticResource TextSecondary}"
                               HorizontalTextAlignment="Center"
                               Text="Kayıtlar sunucudan yüklenir. Bağlantı sorununda API adresini kontrol edin." />
                    </CollectionView.Footer>
                </CollectionView>
            </RefreshView>
            <Grid x:Name="BusyOverlay"
                  IsVisible="False"
                  BackgroundColor="#DDF5FAFF"
                  ZIndex="100">
                <ActivityIndicator x:Name="BusySpinner"
                                   IsRunning="False"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center"
                                   Scale="1.15" />
            </Grid>
            </Grid>
        </Grid>

        <views:HospitalFooterBar Grid.Row="4"
                                 Margin="20,10,20,12" />
    </Grid>
</ContentPage>
