<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Hospital.Client.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Hospital.Client"
    xmlns:views="clr-namespace:Hospital.Client.Views"
    Title="Hastane Yönetimi"
    FlyoutBehavior="Flyout"
    FlyoutWidth="300">

    <Shell.ItemTemplate>
        <DataTemplate>
            <Grid Padding="14,10"
                  ColumnDefinitions="Auto,*"
                  ColumnSpacing="12"
                  BackgroundColor="Transparent">
                <Border WidthRequest="10"
                        HeightRequest="10"
                        VerticalOptions="Center"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource Primary}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="5" />
                    </Border.StrokeShape>
                </Border>
                <Label Grid.Column="1"
                       Text="{Binding Title}"
                       VerticalOptions="Center"
                       FontFamily="OpenSansSemibold"
                       FontSize="15"
                       TextColor="{StaticResource TextPrimary}"
                       LineBreakMode="TailTruncation" />
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

    <Shell.FlyoutHeader>
        <views:PortalFlyoutHeader BadgeText="HY"
                                  Headline="Hastane yönetimi"
                                  Tagline="Hasta, poliklinik, doktor ve randevu yönetimi" />
    </Shell.FlyoutHeader>

    <FlyoutItem Title="Ana sayfa">
        <ShellContent ContentTemplate="{DataTemplate local:AdminHomePage}" Route="AdminHomePage" />
    </FlyoutItem>

    <FlyoutItem Title="Hastalar">
        <ShellContent ContentTemplate="{DataTemplate local:PatientsPage}" Route="PatientsPage" />
    </FlyoutItem>

    <FlyoutItem Title="Poliklinikler">
        <ShellContent ContentTemplate="{DataTemplate local:ClinicsPage}" Route="ClinicsPage" />
    </FlyoutItem>

    <FlyoutItem Title="Doktorlar">
        <ShellContent ContentTemplate="{DataTemplate local:DoctorsPage}" Route="DoctorsPage" />
    </FlyoutItem>

    <FlyoutItem Title="Randevular">
        <ShellContent ContentTemplate="{DataTemplate local:AppointmentsPage}" Route="AppointmentsPage" />
    </FlyoutItem>

    <FlyoutItem Title="Tetkik raporları">
        <ShellContent ContentTemplate="{DataTemplate local:AdminLabReportsPage}" Route="AdminLabReportsPage" />
    </FlyoutItem>

    <FlyoutItem Title="Nöbet ve izinler">
        <ShellContent ContentTemplate="{DataTemplate local:AdminDoctorDutiesPage}" Route="AdminDoctorDutiesPage" />
    </FlyoutItem>

    <FlyoutItem Title="Kurum bilgileri">
        <ShellContent ContentTemplate="{DataTemplate local:AdminProfilePage}" Route="AdminProfilePage" />
    </FlyoutItem>

    <FlyoutItem Title="Şifre Değiştir">
        <ShellContent ContentTemplate="{DataTemplate local:ChangePasswordPage}" Route="ChangePasswordPage" />
    </FlyoutItem>

    <Shell.FlyoutFooter>
        <VerticalStackLayout Padding="16,12,16,14"
                             Spacing="10"
                             BackgroundColor="#E8F4FC">
            <views:HospitalFooterBar Margin="0,0,0,4" />
            <Label x:Name="FlyoutFooterVersion"
                   FontSize="11"
                   TextColor="{StaticResource TextSecondary}"
                   HorizontalTextAlignment="Center" />
            <Label Text="Oturumu kapatınca tekrar giriş gerekir."
                   FontSize="11"
                   TextColor="{StaticResource TextSecondary}"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="WordWrap" />
            <Button Text="Çıkış Yap"
                    Style="{StaticResource OutlineButton}"
                    Clicked="OnLogoutClicked" />
        </VerticalStackLayout>
    </Shell.FlyoutFooter>
</Shell>
